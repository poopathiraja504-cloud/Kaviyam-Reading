rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Preferences (document ID is the userId)
    match /userPreferences/{userId} {
      allow read, write: if true;
    }

    // Wallpapers & Templates
    match /wallpapers/{docId} {
      allow read, write: if true;
    }
    match /templates/{docId} {
      allow read, write: if true;
    }

    // Users and User Subcollections
    match /users/{userId} {
      allow read, write: if true;
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Books, Logs, Emails, and general collections
    match /books/{docId} {
      allow read, write: if true;
    }
    match /logs/{docId} {
      allow read, write: if true;
    }
    match /emails/{docId} {
      allow read, write: if true;
    }

    // Catch-all open rule for top level collections
    match /{collectionName}/{docId} {
      allow read, write: if true;
    }
  }
}
