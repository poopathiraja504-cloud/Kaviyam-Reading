rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for user authentication and authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User documents and subcollections (bookmarks, preferences, history, notes, quizAttempts, xpHistory, levelHistory, wordFinderAttempts):
    // Strictly restricted so that each user can ONLY read and write their own data.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Books catalogue - public read for all patrons, write for authenticated users
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // System connectivity test
    match /test/{docId} {
      allow read: if true;
    }

    // 2. User-specific collections tagged with userId (e.g. user_data, bookmarks, annotations, links):
    match /user_data/{docId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /links/{linkId} {
      // If links are user-owned, only owner can access; otherwise only creator can manage
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Word Finder game attempts, in-progress state, and leaderboard
    match /wordFinderAttempts/{attemptId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /wordFinderProgress/{progressId} {
      allow read, write: if isAuthenticated();
    }

    match /wordFinderLeaderboard/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Root-level quizAttempts collection fallback
    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. Default fallback: Deny all read and write access to all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
