rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default fallback: deny all access to any unspecified document/collection
    match /{document=**} {
      allow read, write: if false;
    }

    // User-specific data: Each user can only read, write, and manage their own document and subcollections.
    // No user can access, read, or modify another user's data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // All user subcollections (e.g., /users/{userId}/bookmarks/{bookId}, /users/{userId}/history/{id}, etc.)
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level user-scoped collections (if documents contain a userId field)
    match /{collectionName}/{docId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}

