{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user profile document in /users/{userId} in Kaviyam Reading",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier of the user (Firebase Auth UID)" },
        "id": { "type": "string", "description": "Alias for the user's UID" },
        "name": { "type": "string", "description": "User's full display name" },
        "email": { "type": "string", "description": "User's email address" },
        "photoFileName": { "type": "string", "description": "File name of user profile picture (e.g., avatar_tamil_scholar.png)" },
        "avatarUrl": { "type": "string", "description": "Optional image URL for the avatar" },
        "username": { "type": "string", "description": "User's username handle" },
        "bio": { "type": "string", "description": "User biography or reading summary" },
        "phone": { "type": "string", "description": "User phone number" },
        "dob": { "type": "string", "description": "Date of birth" },
        "gender": { "type": "string", "description": "Gender identification" },
        "isVerified": { "type": "boolean", "description": "Whether the user email is verified" },
        "role": { "type": "string", "description": "Access role: reader, author, admin" },
        "profile": {
          "type": "object",
          "description": "Inner user profile configurations"
        },
        "security": {
          "type": "object",
          "description": "Inner security parameters"
        },
        "level": { "type": "number", "description": "User's current progression level (1-20)" },
        "levelName": { "type": "string", "description": "Tamil name of the user's current level" },
        "totalXP": { "type": "number", "description": "User's total experience points earned" },
        "levelUpAlert": { "type": "object", "description": "Pending level up notification data if any" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Profile registration timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last profile update timestamp" }
      },
      "required": ["name", "email", "photoFileName"]
    },
    "XpTransaction": {
      "title": "XpTransaction",
      "description": "A transaction log of user experience points earned from actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique transaction ID" },
        "type": { "type": "string", "enum": ["reading", "quiz", "achievement", "challenge", "streak"], "description": "The category of the earned XP" },
        "description": { "type": "string", "description": "Tamil description of the activity" },
        "xp": { "type": "number", "description": "Amount of XP awarded" },
        "sourceId": { "type": "string", "description": "Unique event source ID (prevent duplication)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of the transaction" }
      },
      "required": ["id", "type", "description", "xp", "sourceId", "createdAt"]
    },
    "LevelHistory": {
      "title": "LevelHistory",
      "description": "Historical milestones of user leveling up",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique milestone ID" },
        "previousLevel": { "type": "number", "description": "The user's level before level up" },
        "newLevel": { "type": "number", "description": "The user's level after level up" },
        "xp": { "type": "number", "description": "The total XP threshold reached" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when level was reached" }
      },
      "required": ["id", "previousLevel", "newLevel", "xp", "createdAt"]
    },
    "Book": {
      "title": "Book",
      "description": "Represents a book or AI-generated story inside Kaviyam Reading",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the book" },
        "title": { "type": "string", "description": "The title of the book" },
        "author": { "type": "string", "description": "The author of the book" },
        "description": { "type": "string", "description": "Plot summary or narrative prompt description" },
        "coverUrl": { "type": "string", "description": "URL link to the cover artwork" },
        "genre": { "type": "string", "description": "The genre classification" },
        "chapters": { "type": "array", "description": "All chapters of the book" },
        "rating": { "type": "number", "description": "Average rating value" },
        "ratingCount": { "type": "number", "description": "Total number of review scores" },
        "reviews": { "type": "array", "description": "Embedded list of reader review entries" },
        "isCustomAI": { "type": "boolean", "description": "Specifies if this story was synthesised by Gemini" }
      },
      "required": ["id", "title", "author", "description", "coverUrl", "genre", "chapters"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "An association connecting a reader's saved books",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the bookmarked patron" },
        "bookId": { "type": "string", "description": "Saved book unique identifier" },
        "savedAt": { "type": "string", "format": "date-time", "description": "When the book was saved to bookshelf" }
      },
      "required": ["userId", "bookId"]
    },
    "SecurityLog": {
      "title": "SecurityLog",
      "description": "Records secure system events and authentication operations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log record identifier" },
        "action": { "type": "string", "description": "The action being registered" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the transaction occurred" },
        "device": { "type": "string", "description": "Device metadata string" },
        "ip": { "type": "string", "description": "Internet Protocol network address" },
        "status": { "type": "string", "enum": ["Success", "Failed", "Blocked"], "description": "Transaction result" }
      },
      "required": ["id", "action", "timestamp", "status"]
    },
    "SimulatedEmail": {
      "title": "SimulatedEmail",
      "description": "Simulated SMTP outbound mail messages stored inside Captured Mailbox",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message record identifier" },
        "recipient": { "type": "string", "description": "Destination email box address" },
        "subject": { "type": "string", "description": "Message subject heading" },
        "body": { "type": "string", "description": "Message content text" },
        "sentAt": { "type": "string", "format": "date-time", "description": "Dispatch timestamp" },
        "category": { "type": "string", "enum": ["auth", "security", "newsletter", "announcement"], "description": "Email categorization filter" },
        "read": { "type": "boolean", "description": "Read confirmation state" }
      },
      "required": ["id", "recipient", "subject", "body", "sentAt", "category", "read"]
    },
    "ProjectLink": {
      "title": "ProjectLink",
      "description": "Historical project links, API docs, OTP gateways, and uploaded archives",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique link identifier" },
        "title": { "type": "string", "description": "Display title of the link" },
        "titleTa": { "type": "string", "description": "Tamil translated title" },
        "url": { "type": "string", "description": "Destination Web URL" },
        "category": { "type": "string", "enum": ["app", "security", "api", "archive", "novel", "custom"], "description": "Link category classification" },
        "description": { "type": "string", "description": "Summary or note regarding this link" },
        "descriptionTa": { "type": "string", "description": "Tamil summary description" },
        "uploadedAt": { "type": "string", "format": "date-time", "description": "Uploaded or saved timestamp" },
        "isSystem": { "type": "boolean", "description": "Whether this is a built-in historical system link" }
      },
      "required": ["id", "title", "url", "category", "uploadedAt"]
    },
    "WordFinderAttempt": {
      "title": "WordFinderAttempt",
      "description": "Records completed word finder puzzle attempts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "puzzleId": { "type": "string" },
        "puzzleNumber": { "type": "number" },
        "foundWords": { "type": "array" },
        "score": { "type": "number" },
        "hintsUsed": { "type": "number" },
        "timeTaken": { "type": "number" },
        "status": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "puzzleId", "score", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Core collection storing registered patron user profiles"
    },
    "/books/{bookId}": {
      "schema": "Book",
      "description": "Universal master catalogue of books, novels, and stories"
    },
    "/users/{userId}/bookmarks/{bookId}": {
      "schema": "Bookmark",
      "description": "Association mapping a user's bookmarked stories"
    },
    "/users/{userId}/xpHistory/{transactionId}": {
      "schema": "XpTransaction",
      "description": "The experience points earning history of the user"
    },
    "/users/{userId}/levelHistory/{historyId}": {
      "schema": "LevelHistory",
      "description": "The level-up history logs of the user"
    },
    "/logs/{logId}": {
      "schema": "SecurityLog",
      "description": "System audit logging collection for tracking authentication and profile changes"
    },
    "/emails/{emailId}": {
      "schema": "SimulatedEmail",
      "description": "Captured local SMTP outbound simulated email records"
    },
    "/links/{linkId}": {
      "schema": "ProjectLink",
      "description": "Historical legacy URLs, API specs, and uploaded literary links repository"
    },
    "/wordFinderAttempts/{attemptId}": {
      "schema": "WordFinderAttempt",
      "description": "Saved word finder puzzle scores and completion attempts"
    }
  }
}
